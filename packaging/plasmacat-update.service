[Unit]
Description=Update PlasmaCat to the newest release
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/plasmacat/app
Environment=PYTHONPATH=%h/.local/share/plasmacat/app/src
ExecStart=/usr/bin/env python3 -m plasmacat.updater %h/.local/share/plasmacat/app
StandardOutput=append:%h/.local/state/plasmacat/update.log
StandardError=append:%h/.local/state/plasmacat/update.log
